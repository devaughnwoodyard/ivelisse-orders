rules_version = '2';
// Thank-you text pictures: anyone (Twilio) can read; only managers upload.
service firebase.storage {
  match /b/{bucket}/o {
    match /followup/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.token.email))
        && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
